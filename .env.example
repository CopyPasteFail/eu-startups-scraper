EU_STARTUPS_SEARCH_URL=https://www.eu-startups.com/directory/page/1/?dosrch=1&q&wpbdp_view=search&listingfields%5B1%5D&listingfields%5B2%5D=-1&listingfields%5B7%5D&listingfields%5B6%5D=berlin&listingfields%5B4%5D=-1&wpbdp_sort=-field-10
PIPELINE_POLICY_PATH=config/pipeline_policy.json
OUTPUT_DIR=runtime/exports
STATE_DIR=runtime/state
RAW_DIR=runtime/raw
LOG_DIR=runtime/logs
DB_PATH=runtime/state/pipeline.sqlite3

# Slow, conservative defaults for the deterministic runtime pipeline.
MIN_DELAY_SECONDS=4.0
MAX_DELAY_SECONDS=8.0
REQUEST_TIMEOUT_SECONDS=45
MAX_RETRIES=2
DISABLE_FUNDING_FILTER=0
REFRESH_SEARCH_PAGES=0
REFRESH_COMPANY_PAGES=0
REFRESH_WEBSITE_PAGES=0
REFRESH_SEARCH_FALLBACKS=0
PLAYWRIGHT_HEADLESS=1
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36

# Primary ambiguity workflow:
# 1. run / resume the pipeline
# 2. inspect runtime/exports/review_queue.csv or review_queue.xlsx in Codex app
# 3. have Codex app write or update runtime/exports/review_resolutions.csv
# 4. run `python -m eu_startups_pipeline apply-review`
#
# Smoke-test helper: set DISABLE_FUNDING_FILTER=1 to let all parsed companies
# continue through enrichment and export without changing the tracked funding policy.
#
# Optional future mode only. Disabled by default and not required for normal operation.
ENABLE_RUNTIME_LLM=0
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
